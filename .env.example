# ═══════════════════════════════════════════════════════════════
#  Código del Futuro · Santi Cardenas — Variables de entorno
#  Local: copia este archivo como ".env".
#  Producción: configúralas en Netlify → Site configuration → Environment variables.
#
#  Credenciales: https://www.mercadopago.com.co/developers/panel/credentials
# ═══════════════════════════════════════════════════════════════

# Access Token PRIVADO de MercadoPago (solo backend, nunca en el frontend)
# TEST-... para pruebas, APP_USR-... para producción
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000

# Precio de la boleta en COP (opcional, por defecto 299000).
# Si lo cambias, actualiza también PRICE_COP en config.js y los textos del index.
TICKET_PRICE_COP=299000

# Solo desarrollo local
PORT=3000
BASE_URL=http://localhost:3000
